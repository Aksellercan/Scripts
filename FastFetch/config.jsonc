{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
                   "top": 1,
                   "left": 1,
                   "right": 2
        }
    },
    "modules": [
    	{
			"type": "host",
			"key": "Host",
			"keyColor": "green"
		},
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "green"
		},
		{
			"type": "shell",
			"key": "Shell",
			"keyColor": "green"
		},
		{
			"type": "terminal",
			"key": "Terminal",
			"keyColor": "green"
		},
        {
            "type": "memory",	
            "key": "Memory",
            "keyColor": "green"
        },
		{
			"type": "swap",
			"key": "Swap",
			"keyColor": "green"
		},
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "green"
        },
		{
			"type": "localip",
			"key": "Local IP",
			"keyColor": "green"
		},
		{
			"type": "packages",
			"key": "Packages",
			"keyColor": "green"
		}
    ]
}
